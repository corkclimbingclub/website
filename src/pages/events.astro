---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Events - Cork Climbing Club">
  <main>
    <div class="events-header">
      <h1>Upcoming Events for Club Members</h1>
      <div class="calendar-embed">
        <iframe
          src="https://calendar.google.com/calendar/embed?src=corkclimbingclub%40gmail.com&ctz=Europe%2FDublin"
          style="border: 0"
          width="100%"
          height="600"
          loading="lazy"
          title="Cork Climbing Club calendar"
        ></iframe>
      </div>
    </div>

    <div class="events-info">
      <h2>Regular Event Information</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>Regular Sessions</h3>
          <p>We meet every Monday and Wednesday evenings at Awesome Walls Cork.</p>
        </div>
        <div class="info-card">
          <h3>Outdoor Trips</h3>
          <p>Monthly outdoor adventures to Ireland's best climbing areas. Car pooling encouraged.</p>
        </div>
        <div class="info-card">
          <h3>Workshops and Courses</h3>
          <p>Regular skills workshops and courses covering safety, technique, and training for climbers of all levels.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    padding-top: 180px;
  }

  .events-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .events-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: #333;
  }

  .calendar-embed {
    margin-bottom: 3rem;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .calendar-embed iframe {
    display: block;
  }

  .events-info {
    text-align: center;
    margin-top: 4rem;
  }

  .events-info h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: #333;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .info-card {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 12px;
    border-top: 4px solid #667eea;
  }

  .info-card h3 {
    color: #333;
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }

  .info-card p {
    color: #666;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .events-header h1 {
      font-size: 2rem;
    }
    
    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
