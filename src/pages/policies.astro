---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Policies - Cork Climbing Club">
  <main>
    <div class="content">
      <h1>Policies</h1>
      
      <section>
        <p>
          Below you will find links to our club policies and important documents. 
          These documents outline the guidelines, procedures, and standards that govern our club.
        </p>
      </section>

      <section class="policies-list">
        <h2>Club Documents</h2>
        <ul>
          <li>
            <a href="/child-safeguarding-statement-and-risk-assessment.pdf" target="_blank" rel="noopener noreferrer">
              Child Safeguarding Statement and Risk Assessment
            </a>
            <span class="file-type">PDF</span>
          </li>
          <li>
            <a href="/code-of-conduct.pdf" target="_blank" rel="noopener noreferrer">
              Code of Conduct
            </a>
            <span class="file-type">PDF</span>
          </li>
          <li>
            <a href="/gear-borrowing-terms-and-conditions.pdf" target="_blank" rel="noopener noreferrer">
              Gear Borrowing Terms and Conditions
            </a>
            <span class="file-type">PDF</span>
          </li>
          <li class="placeholder">
            <span class="policy-name">GDPR Policy</span>
            <span class="coming-soon">Coming Soon</span>
          </li>
          <li class="placeholder">
            <span class="policy-name">Club Trip Policy</span>
            <span class="coming-soon">Coming Soon</span>
          </li>
        </ul>
      </section>
    </div>
  </main>
</Layout>

<style>
  .content {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    padding-top: 180px;
    text-align: left;
  }

  h1 {
    text-align: center;
    margin-bottom: 3rem;
    color: #2c3e50;
    font-size: 2.5rem;
  }

  h2 {
    color: #34495e;
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }

  section {
    margin-bottom: 2rem;
  }

  p {
    line-height: 1.6;
    margin-bottom: 1.2rem;
    color: #555;
  }

  .policies-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .policies-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    margin-bottom: 0.75rem;
    background-color: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid #3498db;
    transition: background-color 0.2s ease;
  }

  .policies-list li:hover:not(.placeholder) {
    background-color: #e9ecef;
  }

  .policies-list li.placeholder {
    opacity: 0.6;
    border-left-color: #95a5a6;
    cursor: not-allowed;
  }

  .policies-list li.placeholder:hover {
    background-color: #f8f9fa;
  }

  .policy-name {
    color: #7f8c8d;
    font-weight: 500;
    flex: 1;
  }

  .coming-soon {
    background-color: #95a5a6;
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-left: 1rem;
  }

  .policies-list a {
    color: #2c3e50;
    text-decoration: none;
    font-weight: 500;
    flex: 1;
  }

  .policies-list a:hover {
    color: #3498db;
    text-decoration: underline;
  }

  .file-type {
    background-color: #e74c3c;
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-left: 1rem;
  }

  @media (max-width: 768px) {
    .content {
      padding: 1rem;
      padding-top: 180px;
    }
    
    h1 {
      font-size: 2rem;
      margin-bottom: 2rem;
    }
    
    h2 {
      font-size: 1.5rem;
    }

    .policies-list li {
      flex-direction: column;
      align-items: flex-start;
    }

    .file-type,
    .coming-soon {
      margin-left: 0;
      margin-top: 0.5rem;
    }
  }
</style>
